# ==============================================================================
# VOICE COMPUTER USE AGENTS SDK - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SPEECH-TO-TEXT (STT) BACKENDS
# Choose your preferred dictation engine for capturing audio.
# ------------------------------------------------------------------------------

# Deepgram (Recommended for extreme speed & custom vocabulary boosting)
DEEPGRAM_API_KEY=""

# OpenAI Whisper (Cloud API)
WHISPER_API_KEY=""

# Local Whisper / Whisper.cpp (No API key required, point to local server)
# WHISPER_LOCAL_URL="http://localhost:8080/v1/audio/transcriptions"

# Vapi.ai (For conversational voice agents / continuous listening)
VAPI_API_KEY=""
VAPI_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# 2. LLM PARSING ENGINE (Instructor / Pydantic)
# Translates the raw transcript into executable JSON schemas.
# ------------------------------------------------------------------------------

# Groq (Recommended: Fastest LPU inference for real-time dictation parsing)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# OpenAI (Fallback/Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Local LLM (Ollama / vLLM / Llama.cpp)
# LOCAL_LLM_URL="http://localhost:11434/v1"
# LOCAL_LLM_MODEL="llama3.1:8b"

# ------------------------------------------------------------------------------
# 3. TEXT-TO-SPEECH (TTS) FEEDBACK
# For audio confirmation of commands (e.g. "Command executed", "Typing...")
# ------------------------------------------------------------------------------

# Kokoro TTS (Recommended: Extremely fast, high quality local TTS)
# KOKORO_SERVER_URL="http://localhost:8880/v1/audio/speech"

# ElevenLabs (Cloud alternative)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ------------------------------------------------------------------------------
# 4. EXECUTION BACKEND
# How the parsed schemas actually interact with the OS.
# ------------------------------------------------------------------------------

# Options: "NATIVE_WAYLAND", "TALON_VOICE", "AGENTIC_MCP"
# Native Wayland uses `wtype` and `subprocess` (zero dependencies).
# Talon Voice uses the Talon Python API (if installed).
EXECUTION_MODE="NATIVE_WAYLAND"

# ------------------------------------------------------------------------------
# 5. MCP (Model Context Protocol) SERVERS
# ------------------------------------------------------------------------------
# Auto-discover tools from local MCP servers
CODEBASE_MEMORY_MCP_URL="http://localhost:9749"
CONTEXT7_MCP_URL="http://localhost:8000"
